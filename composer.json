{
    "name": "saizul/woo-courier-export",
    "description": "Bulk-export WooCommerce orders to CSV for Bangladeshi couriers (Steadfast, Pathao, RedX) or a configurable template.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": ["woocommerce", "courier", "bangladesh", "steadfast", "pathao", "redx", "csv", "export"],
    "homepage": "https://github.com/saizul/woo-courier-export",
    "authors": [
        {
            "name": "Saizul Amin",
            "homepage": "https://saizul.com"
        }
    ],
    "support": {
        "issues": "https://github.com/saizul/woo-courier-export/issues",
        "source": "https://github.com/saizul/woo-courier-export"
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Saizul\\CourierExport\\WP\\": "includes/",
            "Saizul\\CourierExport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saizul\\CourierExport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "7.4.33"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
