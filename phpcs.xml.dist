<?xml version="1.0"?>
<ruleset name="Courier Export for WooCommerce">
	<description>WordPress Coding Standards for the plugin code.</description>

	<file>woo-courier-export.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>src</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Classes are autoloaded with PSR-4, so file names follow class names. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woo-courier-export"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="woo_courier_export"/>
				<element value="Saizul\CourierExport"/>
			</property>
		</properties>
	</rule>
</ruleset>
